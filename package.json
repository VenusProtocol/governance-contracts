{
  "name": "@venusprotocol/governance-contracts",
  "description": "",
  "repository": "git@github.com:VenusProtocol/governance-contracts.git",
  "version": "2.16.0",
  "author": "",
  "files": [
    "artifacts",
    "typechain",
    "dist",
    "deploy",
    "deployments",
    "contracts"
  ],
  "keywords": [
    "blockchain",
    "ethers",
    "ethereum",
    "hardhat",
    "smart-contracts",
    "solidity",
    "template",
    "typescript",
    "typechain"
  ],
  "packageManager": "yarn@3.2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "compile": "hardhat compile && hardhat compile --config hardhat.config.zksync.ts",
    "test": "hardhat test",
    "test:foundry": "forge test",
    "build": "rm -rf dist && hardhat compile && hardhat compile --config hardhat.config.zksync.ts && tsc --declaration",
    "publish:dist": "yarn build && cd dist && yarn publish --access public",
    "lint": "yarn lint:ts && yarn lint:sol && yarn prettier:check",
    "lint:ts": "eslint --ignore-path ./.eslintignore --ext .js,.ts .",
    "lint:sol": "solhint \"contracts/**/*.sol\"",
    "lint:sol:fix": "prettier --write \"contracts/**/*.sol\"",
    "prettier": "prettier  --write \"**/*.{js,json,md,ts,yaml,yml,sol}\"",
    "prettier:check": "prettier --check \"**/*.{js,json,md,ts,yaml,yml,sol}\"",
    "prettier:cached": "prettier --write --cache \"**/*.{js,json,md,ts,yaml,yml,sol}\"",
    "check:upgrade-safety": "openzeppelin-upgrades-core validate artifacts/build-info --exclude \"contracts/test/**/*.sol\" --exclude \"hardhat-deploy/**/*.sol\" --exclude \"@layerzerolabs/oapp-evm-upgradeable/**/*.sol\" --unsafeAllow state-variable-immutable && openzeppelin-upgrades-core validate artifacts/build-info --contract GovernorBravoDelegate",
    "check:storage-layout": "hardhat run scripts/checkStorageLayout.ts",
    "check:upgrades": "yarn check:storage-layout && yarn check:upgrade-safety",
    "docgen": "hardhat docgen",
    "prepare": "husky install",
    "clean": "hardhat clean && hardhat clean --config hardhat.config.zksync.ts && rm -rf out cache-foundry",
    "postinstall": "yarn patch-package",
    "acm:fetch": "ts-node scripts/acm-permissions/cli.ts fetch",
    "acm:verify": "ts-node scripts/acm-permissions/cli.ts verify",
    "acm:filter": "ts-node scripts/acm-permissions/cli.ts filter",
    "acm:build-registry": "ts-node scripts/acm-permissions/cli.ts build-registry",
    "acm:relabel": "ts-node scripts/acm-permissions/cli.ts relabel"
  },
  "dependencies": {
    "@venusprotocol/solidity-utilities": "2.0.0",
    "hardhat-deploy-ethers": "^0.3.0-beta.13",
    "module-alias": "^2.2.2",
    "patch-package": "^8.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.4.4",
    "@commitlint/config-conventional": "^17.4.4",
    "@defi-wonderland/smock": "2.4.0",
    "@ethersproject/abi": "^5.7.0",
