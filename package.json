    "eslint-plugin-sonarjs": "^1.0.4",
    "ethers": "^5.7.2",
    "fs-extra": "^10.1.0",
    "hardhat": "2.22.18",
    "hardhat-dependency-compiler": "^1.1.3",
    "hardhat-deploy": "^0.12.4",
    "hardhat-docgen": "^1.3.0",
    "hardhat-gas-reporter": "^1.0.9",
    "husky": "^8.0.3",
    "lint-staged": "^13.0.4",
    "lodash": "^4.17.21",
    "mocha": "^10.1.0",
    "pinst": "^3.0.0",
    "prettier": "^2.8.4",
    "prettier-plugin-solidity": "^1.1.2",
    "semantic-release": "^25.0.2",
    "shx": "^0.3.4",
    "solhint": "^3.4.0",
    "solhint-plugin-prettier": "^0.0.5",
    "solidity-bytes-utils": "^0.8.4",
    "solidity-coverage": "^0.8.4",
    "solidity-docgen": "^0.6.0-beta.34",
    "ts-generator": "^0.1.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.2",
    "typechain": "^8.1.1",
    "typescript": "^4.9.3",
    "typescript-retry-decorator": "^2.4.2",
    "zksync-ethers": "^5.9.1"
  },
  "_moduleAliases": {
    "@nomiclabs/hardhat-ethers": "node_modules/hardhat-deploy-ethers"
  },
