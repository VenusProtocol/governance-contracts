    "@ethersproject/bignumber": "^5.7.0",
    "@ethersproject/bytes": "^5.7.0",
    "@ethersproject/providers": "^5.7.2",
    "@layerzerolabs/lz-evm-messagelib-v2": "^3.0.147",
    "@layerzerolabs/lz-evm-protocol-v2": "^3.0.147",
    "@layerzerolabs/oapp-evm": "^0.4.0",
    "@layerzerolabs/oapp-evm-upgradeable": "^0.1.2",
    "@layerzerolabs/solidity-examples": "^1.0.0",
    "@layerzerolabs/test-devtools-evm-hardhat": "^0.5.2",
    "@matterlabs/hardhat-zksync": "^0.2.0",
    "@matterlabs/hardhat-zksync-deploy": "^0.11.0",
    "@matterlabs/hardhat-zksync-solc": "^1.2.1",
    "@matterlabs/hardhat-zksync-verify": "0.7.0",
    "@nomicfoundation/hardhat-chai-matchers": "^1.0.4",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.6",
    "@nomicfoundation/hardhat-verify": "^2.0.14",
    "@nomiclabs/hardhat-ethers": "^2.2.1",
    "@openzeppelin/contracts": "^4.9.6",
    "@openzeppelin/contracts-upgradeable": "^4.8.2",
    "@openzeppelin/hardhat-upgrades": "^1.22.1",
    "@openzeppelin/upgrades-core": "1.41.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^4.0.0",
    "@typechain/ethers-v5": "^10.1.1",
    "@typechain/hardhat": "^6.1.4",
    "@types/chai": "^4.3.4",
    "@types/debug": "^4.1.12",
    "@types/fs-extra": "^9.0.13",
    "@types/inquirer": "^9.0.7",
    "@types/lodash": "^4.17.6",
